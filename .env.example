# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mono_attendance
# Host port for local `npm run dev` (container port is always 5432).
POSTGRES_HOST_PORT=5433

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST_PORT=6379

# ── Backend ───────────────────────────────────────────────
BACKEND_PORT=3000
API_KEY=change-me
JWT_SECRET=change-me
JWT_ACCESS_TTL=900

# ── Frontend ──────────────────────────────────────────────
FRONTEND_PORT=5173

# ── pgAdmin ───────────────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
